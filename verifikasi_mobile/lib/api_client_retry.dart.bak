import 'dart:async';
import 'dart:convert';
import 'package:http/http.dart' as http;
import 'auth_service.dart';
import 'config.dart' as config_module;

/// Enhanced API Client with auto-retry, timeout handling, and sleep recovery
class ApiClientRetry {
  static const int maxRetries = 3;
  static const Duration timeout = Duration(seconds: 10);
  static const Duration retryDelay = Duration(seconds: 2);

  /// Make HTTP request with auto-retry logic
  static Future<http.Response> _makeRequest(
    Future<http.Response> Function() request, {
    int retries = 0,
  }) async {
    try {
      // Set timeout for the request
      final response = await request().timeout(
        timeout,
        onTimeout: () {
          throw TimeoutException('Request timeout after ${timeout.inSeconds}s');
        },
      );
      return response;
    } on TimeoutException catch (e) {
      print('[API] Timeout: $e');
      if (retries < maxRetries) {
        print('[API] Retrying after sleep (attempt ${retries + 1}/$maxRetries)');
        await Future.delayed(retryDelay);
        return _makeRequest(request, retries: retries + 1);
      }
      rethrow;
    } catch (e) {
      print('[API] Error: $e');
      // Jika connection error (PC bangun dari sleep), retry
      if (e.toString().contains('Connection') ||
          e.toString().contains('refused') ||
          e.toString().contains('Host') ||
          e.toString().contains('unreachable')) {
        if (retries < maxRetries) {
          print('[API] Connection error, retrying (attempt ${retries + 1}/$maxRetries)');
          await Future.delayed(retryDelay * (retries + 1)); // Exponential backoff
          return _makeRequest(request, retries: retries + 1);
        }
      }
      rethrow;
    }
  }

  static Map<String, dynamic> _tryJson(String body) {
    try {
      final parsed = jsonDecode(body);
      if (parsed is Map<String, dynamic>) return parsed;
      return {'data': parsed};
    } catch (_) {
      return {'error': body};
    }
  }

  /// Fetch logs dengan auto-retry
  static Future<List<Map<String, dynamic>>> fetchLogs() async {
    try {
      final response = await _makeRequest(() {
        return http.get(
          Uri.parse('${config_module.ServerConfig.baseUrl}/logs'),
        );
      });

      if (response.statusCode >= 400) {
        final body = _tryJson(response.body);
        throw Exception(body['error'] ?? 'Gagal mengambil data');
      }

      final body = _tryJson(response.body);
      final List<dynamic> logs = body['logs'] ?? [];
      return logs.cast<Map<String, dynamic>>();
    } catch (e) {
      print('[API] fetchLogs error: $e');
      rethrow;
    }
  }

  /// Approve pengawas dengan auto-retry
  static Future<Map<String, dynamic>> accPengawas(String id) async {
    try {
      final response = await _makeRequest(() {
        return http.post(
          Uri.parse('${config_module.ServerConfig.baseUrl}/scan-pengawas'),
          headers: {'Content-Type': 'application/json'},
          body: jsonEncode({
            'id_karyawan': id,
            'username': AuthService.username,
          }),
        );
      });

      final data = _tryJson(response.body);
      if (response.statusCode >= 400) {
        throw Exception(data['error'] ?? 'Gagal ACC pengawas');
      }
      return data;
    } catch (e) {
      print('[API] accPengawas error: $e');
      rethrow;
    }
  }

  /// Approve security dengan auto-retry
  static Future<Map<String, dynamic>> accSecurity(String id) async {
    try {
      final response = await _makeRequest(() {
        return http.post(
          Uri.parse('${config_module.ServerConfig.baseUrl}/scan-security'),
          headers: {'Content-Type': 'application/json'},
          body: jsonEncode({
            'id_karyawan': id,
            'username': AuthService.username,
          }),
        );
      });

      final data = _tryJson(response.body);
      if (response.statusCode >= 400) {
        throw Exception(data['error'] ?? 'Gagal ACC security');
      }
      return data;
    } catch (e) {
      print('[API] accSecurity error: $e');
      rethrow;
    }
  }

  /// Daily reset dengan auto-retry
  static Future<Map<String, dynamic>> dailyReset() async {
    try {
      final response = await _makeRequest(() {
        return http.post(
          Uri.parse('${config_module.ServerConfig.baseUrl}/daily-reset'),
          headers: {'Content-Type': 'application/json'},
        );
      });

      final data = _tryJson(response.body);
      if (response.statusCode >= 400) {
        throw Exception(data['error'] ?? 'Gagal melakukan daily reset');
      }
      return data;
    } catch (e) {
      print('[API] dailyReset error: $e');
      rethrow;
    }
  }

  /// Delete log dengan auto-retry
  static Future<void> deleteLog(String idKaryawan) async {
    try {
      final response = await _makeRequest(() {
        return http.delete(
          Uri.parse('${config_module.ServerConfig.baseUrl}/logs/$idKaryawan'),
          headers: {'Content-Type': 'application/json'},
        );
      });

      if (response.statusCode >= 400) {
        final data = _tryJson(response.body);
        throw Exception(data['error'] ?? 'Gagal menghapus log');
      }
    } catch (e) {
      print('[API] deleteLog error: $e');
      rethrow;
    }
  }

  /// Update log status dengan auto-retry
  static Future<Map<String, dynamic>> updateLogStatus(
    String idKaryawan,
    String statusPengawas,
    String statusSecurity,
  ) async {
    try {
      final response = await _makeRequest(() {
        return http.put(
          Uri.parse('${config_module.ServerConfig.baseUrl}/logs/$idKaryawan'),
          headers: {'Content-Type': 'application/json'},
          body: jsonEncode({
            'status_pengawas': statusPengawas,
            'status_security': statusSecurity,
          }),
        );
      });

      final data = _tryJson(response.body);
      if (response.statusCode >= 400) {
        throw Exception(data['error'] ?? 'Gagal mengupdate log');
      }
      return data;
    } catch (e) {
      print('[API] updateLogStatus error: $e');
      rethrow;
    }
  }

  /// Get logs by date dengan auto-retry
  static Future<List<Map<String, dynamic>>> fetchLogsByDate(String date) async {
    try {
      final response = await _makeRequest(() {
        return http.get(
          Uri.parse('${config_module.ServerConfig.baseUrl}/logs-history/$date'),
        );
      });

      if (response.statusCode >= 400) {
        final body = _tryJson(response.body);
        throw Exception(body['error'] ?? 'Gagal mengambil data');
      }

      final body = _tryJson(response.body);
      final List<dynamic> logs = body['logs'] ?? [];
      return logs.cast<Map<String, dynamic>>();
    } catch (e) {
      print('[API] fetchLogsByDate error: $e');
      rethrow;
    }
  }

  /// Check server connectivity
  static Future<bool> checkConnectivity() async {
    try {
      final response = await http.get(
        Uri.parse('${config_module.ServerConfig.baseUrl}/logs'),
      ).timeout(
        const Duration(seconds: 5),
        onTimeout: () => http.Response('timeout', 0),
      );
      return response.statusCode >= 200 && response.statusCode < 500;
    } catch (e) {
      print('[API] Connection check failed: $e');
      return false;
    }
  }
}
